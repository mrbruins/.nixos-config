  "settings": "{\"workbench.colorTheme\":\"Monokai Pro\",\"workbench.preferredDarkColorTheme\":\"Monokai Pro\",\"workbench.iconTheme\":\"Monokai Pro Icons\",\"window.autoDetectColorScheme\":true,\"workbench.colorCustomizations\":{\"tab.activeBorder\":\"#00A6FF\",\"tab.unfocusedActiveBorder\":\"#ff000000\"},\"workbench.sideBar.location\":\"right\",\"workbench.startupEditor\":\"none\",\"editor.tabSize\":2,\"editor.insertSpaces\":true,\"editor.formatOnSave\":true,\"editor.bracketPairColorization.enabled\":true,\"editor.rulers\":[120],\"nix.enableLanguageServer\":true,\"nix.serverPath\":\"nil\",\"nix.serverSettings\":{\"nil\":{\"formatting\":{\"command\":[\"nixfmt\"]}}},\"files.associations\":{\"*.nix\":\"nix\"},\"terminal.integrated.fontFamily\":\"'MesloLGL Nerd Font'\",\"terminal.explorerKind\":\"external\",\"terminal.external.osxExec\":\"Warp.app\",\"chat.tools.terminal.autoApprove\":{\"nix\":true},\"git.autofetch\":true,\"git.enableSmartCommit\":true,\"git.confirmSync\":false,\"github.gitProtocol\":\"ssh\",\"github.copilot.editor.enableAutoCompletions\":true,\"github.copilot.nextEditSuggestions.enabled\":true,\"github.copilot.preferredAccount\":\"mrbruins\",\"github.copilot.advanced\":{\"authProvider\":\"github\"},\"[yaml]\":{\"editor.insertSpaces\":true,\"editor.tabSize\":2,\"editor.autoIndent\":\"keep\",\"editor.quickSuggestions\":{\"other\":true,\"comments\":false,\"strings\":true}},\"evenBetterToml.formatter.alignComments\":true,\"json.validate.enable\":false,\"security.workspace.trust.untrustedFiles\":\"open\",\"telemetry.telemetryLevel\":\"off\",\"redhat.telemetry.enabled\":false,\"remote.SSH.configFile\":\"/Users/michielbruins/.ssh/vscode/config\",\"remote.SSH.connectTimeout\":1800,\"remote.SSH.remotePlatform\":{\"*.gitpod.io\":\"linux\",\"truenas.m11s.nl\":\"linux\"},\"githubPullRequests.pullBranch\":\"never\",\"githubIssues.queries\":[{\"label\":\"My Issues\",\"query\":\"is:open assignee:${user} repo:${owner}/${repository}\",\"groupBy\":[\"milestone\"]},{\"