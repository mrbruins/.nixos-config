#!/usr/bin/env bash
# Show how this Mac's settings differ from the repo checkout you run it from.
#
#   nix run .#settings-diff -- [--host <name>]
#
# Compares System Settings with settings/shared.nix plus settings/<host>/system.nix,
# and each app in settings/apps/manifest with its settings/apps/<domain>.plist.
# Writes nothing.
set -euo pipefail
. "$(dirname "$0")/../../lib/settings-common.sh"

while [ $# -gt 0 ]; do
  case "$1" in
    --host) host="$2"; shift ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "Unknown argument: $1" ;;
  esac
  shift
done

root=$(checkout)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

say "System Settings ($host):"
"$NPM_CURRENT" "$work/raw.nix" 2>/dev/null
changes=$(settingsEval "diff { settingsDir = $(nixPath "$root/settings"); host = \"$host\"; raw = $(nixPath "$work/raw.nix"); ignoreFile = $(nixPath "$root/settings/ignore.txt"); }")
if [ -n "$changes" ]; then printf '%s\n' "$changes"; else ok "  no differences"; fi

say "Apps:"
while read -r domain globs; do
  stored="$root/settings/apps/$domain.plist"
  if ! exportDomain "$domain" "$work/domain.plist"; then
    say "  $domain: can't read it on this Mac"
    continue
  fi
  # shellcheck disable=SC2086
  (set -f; plistKeys filter "$work/domain.plist" "$work/mac.plist" $globs) >/dev/null
  if [ -f "$stored" ]; then cp "$stored" "$work/repo.plist"; else plistKeys filter "$work/mac.plist" "$work/repo.plist" >/dev/null; fi
  changes=$(plistKeys diff "$work/repo.plist" "$work/mac.plist")
  if [ -n "$changes" ]; then
    echo "  $domain (+ on this Mac only, - in the repo only, ~ changed here):"
    printf '%s\n' "$changes" | sed 's/^/    /'
  else
    ok "  $domain: no differences"
  fi
done < <(manifestEntries "$root/settings/apps/manifest")
