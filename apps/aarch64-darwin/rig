#!/bin/bash
# Day-to-day command for a Mac managed by this repository. See `rig help`.
set -euo pipefail

HOST="${RIG_HOST:-$(/usr/sbin/scutil --get LocalHostName)}"
REPO="${RIG_REPO:-}"
DOTFILES="${RIG_DOTFILES:-$HOME/.dotfiles}"
# Filled in by modules/darwin/rig.nix.
DECLARED="${RIG_DECLARED:-}"
APPS="${RIG_APPS:-$(cd "$(dirname "$0")" && pwd)}"

say() { printf '\033[1;33m==> %s\033[0m\n' "$*" >&2; }
die() { printf '\033[0;31mError: %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
rig build                 build this Mac from the checkout, change nothing
rig switch                build and activate the checkout, whatever branch it is on
rig update                pull main, switch, update Homebrew and exempt tools, show drift
rig drift                 list what is installed or running but not declared; changes nothing
rig rollback [gen]        re-activate a retained generation, offline
rig pin                   keep the running system as known-good
rig settings <command>    capture, diff, apply or watch macOS settings
rig link [option]         link the private dotfiles; --check, --adopt or --replace
rig try <package>... [-- <command>]   use a package without installing it

The checkout is the current directory's, or ~/.nixos-config. Override with RIG_REPO, and the host with RIG_HOST.
EOF
}

# The flake to act on: the checkout you are in, else the usual place.
findRepo() {
  if [[ -z "$REPO" ]]; then
    REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -n "$REPO" && -f "$REPO/hosts/darwin/Mac-Studio.nix" ]] || REPO="$HOME/.nixos-config"
  fi
  [[ -f "$REPO/flake.nix" ]] || die "no checkout at $REPO; clone the repository there or set RIG_REPO"
  if [[ -n "$(git -C "$REPO" ls-files --unmerged)" ]]; then
    die "$REPO has unresolved merge conflicts"
  fi
}

build() {
  findRepo
  say "Building $HOST from $REPO ($(git -C "$REPO" branch --show-current || true))"
  nix build "$REPO#darwinConfigurations.$HOST.system" --no-link --print-out-paths "$@"
}

switch() {
  local system
  # Here, not only in build: that runs in a subshell, which cannot set REPO.
  findRepo
  system="$(build "$@")"
  nix store diff-closures /run/current-system "$system" >&2 || true
  say "Activating"
  sudo "$system/sw/bin/darwin-rebuild" switch --flake "$REPO#$HOST"
}

update() {
  findRepo
  [[ "$(git -C "$REPO" branch --show-current)" == main ]] || die "$REPO is not on main; use rig switch for a branch"
  [[ -z "$(git -C "$REPO" status --porcelain)" ]] || die "$REPO has local changes; commit them on a branch first"
  say "Pulling main"
  git -C "$REPO" pull --ff-only
  switch
  if [[ -x /opt/homebrew/bin/brew ]]; then
    say "Homebrew"
    /opt/homebrew/bin/brew update
    /opt/homebrew/bin/brew upgrade
  fi
  # Exempt from the cooldown: docs/adr/0003-seven-day-cooldown.md.
  if [[ -x "$HOME/.local/bin/claude" ]]; then
    say "Claude Code"
    "$HOME/.local/bin/claude" update
  fi
  drift
}

# section <title>: prints stdin as a list, or nothing when it is empty.
section() {
  local lines
  lines="$(sed '/^[[:space:]]*$/d')"
  [[ -n "$lines" ]] || return 0
  # shellcheck disable=SC2001 # every line is indented, not one match
  printf '\n%s\n%s\n' "$1" "$(sed 's/^/  /' <<<"$lines")"
}

declared() { [[ -n "$DECLARED" ]] && sed 's#.*/##' "$DECLARED/$1" | sort -u || true; }
executables() { find "$1" -maxdepth 1 -mindepth 1 ! -lname '/nix/store/*' -perm +111 -exec basename {} \; 2>/dev/null | sort || true; }

drift() {
  local brew=/opt/homebrew/bin/brew
  if [[ -x "$brew" && -n "$DECLARED" ]]; then
    comm -23 <("$brew" leaves --installed-on-request 2>/dev/null | sed 's#.*/##' | sort -u) <(declared brews) \
      | section "Homebrew formulae not declared"
    comm -23 <("$brew" list --cask -1 2>/dev/null | sort -u) <(declared casks) | section "Homebrew casks not declared"
    comm -13 <("$brew" list --cask -1 2>/dev/null | sort -u) <(declared casks) | section "Declared casks not installed"
    comm -13 <("$brew" list --formula -1 2>/dev/null | sort -u) <(declared brews) | section "Declared formulae not installed"
  fi

  local prefix
  for prefix in "$HOME/.npm-packages" "$HOME/.npm-global"; do
    find "$prefix/lib/node_modules" -maxdepth 2 -mindepth 1 -name package.json -prune -o \
      -path "$prefix/lib/node_modules/@*/*" -prune -print -o \
      -path "$prefix/lib/node_modules/[!@.]*" -prune -print 2>/dev/null \
      | sed "s#$prefix/lib/node_modules/##" | sort -u | section "npm packages in $prefix"
  done
  find "$HOME/.local/share/uv/tools" -maxdepth 1 -mindepth 1 -type d ! -name '.*' -exec basename {} \; 2>/dev/null \
    | sort | section "uv tools"
  # Claude Code is an exempt tool with its own updater.
  for prefix in "$HOME/.local/bin" "$HOME/go/bin" "$HOME/.cargo/bin" "$HOME/.bun/bin"; do
    executables "$prefix" | { grep -vx claude || true; } | section "Programs in $prefix"
  done
  for prefix in "$HOME/.nvm/versions/node" "$HOME/.pyenv/versions"; do
    find "$prefix" -maxdepth 1 -mindepth 1 -exec basename {} \; 2>/dev/null | sort | section "Runtimes in $prefix"
  done

  # nix-darwin leaves an agent behind when its service is removed some other way.
  comm -23 \
    <(find "$HOME/Library/LaunchAgents" -name 'org.nixos.*.plist' -exec basename {} \; 2>/dev/null | sort) \
    <(find -L /run/current-system/user/Library/LaunchAgents "$HOME/.local/state/nix/profiles/home-manager/LaunchAgents" \
      -name '*.plist' -exec basename {} \; 2>/dev/null | sort -u) \
    | section "Launch agents no longer declared"

  if [[ -x "$DOTFILES/link" ]]; then
    { "$DOTFILES/link" --check || true; } | section "Private dotfiles not linked"
    git -C "$DOTFILES" status --short | section "Uncommitted changes in $DOTFILES"
  else
    echo "run rig link" | section "No private dotfiles at $DOTFILES"
  fi

  findRepo
  git -C "$REPO" status --short | section "Uncommitted changes in $REPO"
  local want
  if want="$(nix eval --raw "$REPO#darwinConfigurations.$HOST.system.outPath" 2>/dev/null)"; then
    [[ "$want" == "$(readlink -f /run/current-system)" ]] \
      || echo "run rig switch to activate it" | section "The running system is not what $REPO describes"
  else
    echo "nix eval failed" | section "Could not evaluate $REPO"
  fi
}

link() {
  if [[ ! -d "$DOTFILES" ]]; then
    say "Cloning the private dotfiles to $DOTFILES"
    git clone git@github.com:mrbruins/dotfiles.git "$DOTFILES"
  fi
  exec "$DOTFILES/link" "$@"
}

try() {
  local packages=()
  while [[ $# -gt 0 && "$1" != -- ]]; do
    packages+=("nixpkgs#$1")
    shift
  done
  [[ ${#packages[@]} -gt 0 ]] || die "usage: rig try <package>... [-- <command>]"
  findRepo
  # The checkout's locked nixpkgs, so the cooldown applies here too.
  if [[ "${1:-}" == -- ]]; then
    shift
    exec nix shell --inputs-from "$REPO" "${packages[@]}" --command "$@"
  fi
  exec nix shell --inputs-from "$REPO" "${packages[@]}"
}

command="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$command" in
  build) build "$@" ;;
  switch) switch "$@" ;;
  update) update ;;
  drift) drift ;;
  rollback) exec "$APPS/rollback" "$@" ;;
  pin) exec "$APPS/pin-known-good" ;;
  link) link "$@" ;;
  try) try "$@" ;;
  settings)
    sub="${1:-}"
    [[ $# -eq 0 ]] || shift
    case "$sub" in
      capture) app=capture-settings ;;
      diff) app=settings-diff ;;
      apply) app=apply-settings ;;
      watch) app=settings-watch ;;
      *) die "usage: rig settings capture|diff|apply|watch [options]" ;;
    esac
    findRepo
    cd "$REPO"
    exec nix run ".#$app" -- "$@"
    ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
